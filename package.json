{
  "name": "admin-panel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 3002",
    "prebuild": "node scripts/check-section-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "check:shared": "node scripts/check-section-runtime.mjs",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5",
    "vite": "^7.2.4",
    "tsx": "^4"
  }
}
