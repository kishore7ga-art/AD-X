# Copy to .env for local development. Vite only exposes variables prefixed
# VITE_ to the browser, and everything in this file IS in the browser bundle —
# so nothing secret belongs here. The admin session is an httpOnly cookie the
# API sets; there is no token for this app to hold.

# The backend's origin, scheme and port included.
#
# Must appear verbatim in the API's own CORS_ORIGINS, or every request is
# rejected before it is answered.
#
#   local        http://localhost:4000
#   production   https://api.webxite.org
VITE_API_BASE_URL=http://localhost:4000

# The frontend studio app's base URL for linking directly to editor instances.
#   local        http://localhost:3000
#   production   https://webxite.org
VITE_STUDIO_BASE_URL=http://localhost:3000

